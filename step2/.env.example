# Copy to .env and paste your key. Never commit .env.
OPENAI_API_KEY=sk-...

# LiteLLM model string: "<provider>/<model>". The reference example used "sap/gpt-4o".
LLM_MODEL=openai/gpt-4o
LLM_TEMPERATURE=0.7

# How long a story waits for human approval before it expires.
APPROVAL_TIMEOUT_HOURS=24

# Step 2: the flaky publisher MCP server (mcp_server/publisher.py).
MCP_URL=http://127.0.0.1:8765/mcp
# Each story fails this many publish attempts, then succeeds.
MCP_FAIL_TIMES=7
