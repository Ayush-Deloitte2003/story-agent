{
  "name": "step4-flight-booking-demo",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8000, 8001],
  "portsAttributes": {
    "8000": { "label": "flight-api (/ui)", "visibility": "private", "onAutoForward": "notify" },
    "8001": { "label": "support-service", "visibility": "private", "onAutoForward": "silent" }
  }
}
